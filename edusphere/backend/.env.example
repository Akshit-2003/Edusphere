# PostgreSQL / Neon connection (required)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require

# SMTP mail delivery for email verification OTPs (required in production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM_EMAIL=EduSphere <notifications@example.com>
SMTP_USE_TLS=true
